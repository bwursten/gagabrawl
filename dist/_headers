# Caching rules for Netlify / Cloudflare Pages.
# Hashed asset filenames never change contents, so cache them forever.
/js/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable

# The entry page must revalidate so new builds (new hashes) are picked up.
/index.html
  Cache-Control: public, max-age=300, must-revalidate
